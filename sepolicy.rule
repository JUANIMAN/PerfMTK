# PerfMTK SELinux rules for UNIX domain abstract sockets (@perfmtkd_ctrl, @fg_monitor_socket) & Zero-Copy SHM (memfd)

# system_server connection to su / ksu / magisk daemons
allow system_server su unix_stream_socket { connectto read write getattr getopt }
allow system_server ksu unix_stream_socket { connectto read write getattr getopt }
allow system_server magisk unix_stream_socket { connectto read write getattr getopt }

# User apps & PerfMTK Manager / Telemetry socket & SCM_RIGHTS fd passing
# Note: @perfmtkd_ctrl enforces per-command privilege checks via SO_PEERCRED
allow untrusted_app_all su unix_stream_socket { connectto read write getattr getopt }
allow untrusted_app_all ksu unix_stream_socket { connectto read write getattr getopt }
allow untrusted_app_all magisk unix_stream_socket { connectto read write getattr getopt }
allow untrusted_app_all su fd use
allow untrusted_app_all ksu fd use
allow untrusted_app_all magisk fd use
allow untrusted_app_all tmpfs file { read getattr map }

# SurfaceFlinger hardware acceleration & MediaTek PerfMgr ioctls
allow surfaceflinger proc_perfmgr file { ioctl read write open getattr }
allow surfaceflinger proc_perfmgr dir { search read open getattr }
allow surfaceflinger mcd_data_file dir { search read open getattr }
allow surfaceflinger mcd_data_file file { read open getattr }

# PerfMTK PowerHAL LD_PRELOAD hook & shared binary gate permissions
allow mtk_hal_power vendor_file dir { read open getattr search }
allow mtk_hal_power vendor_file file { read open getattr map execute execute_no_trans }
allow mtk_hal_power mtk_hal_power_exec file { execute execute_no_trans read open getattr map }
allow mtk_hal_power mtk_powerhal_data_file dir { read open getattr search }
allow mtk_hal_power mtk_powerhal_data_file file { read open getattr map }
allow mtk_hal_power vendor_data_file dir { read open getattr search }
allow mtk_hal_power vendor_data_file file { read open getattr map }
