# OpenGL ES
ro.opengles.version=196610

# GPU
ro.gfx.driver.0=

# SurfaceFlinger & HyperOS Display Overrides
debug.sf.enable_transaction_tracing=false
ro.surface_flinger.set_touch_timer_ms=1000
debug.sf.set_touch_timer_ms=1000
ro.vendor.disable_idle_fps.threshold=1
persist.vendor.disable_idle_fps.threshold=1
persist.vendor.disable_idle_fps=0
debug.sf.hwc.min.duration=1000000
ro.surface_flinger.max_frame_buffer_acquired_buffers=3

# LMK
sys.lmk.reportkills=0
persist.sys.lmk.reportkills=false
sys.lmk.minfree_levels=8192:0,10240:100,12288:200,14336:250,40960:900,61440:950
ro.lmk.psi_partial_stall_ms=250

# LOW RAM
ro.config.low_ram=

# DALVIK
dalvik.vm.usap_pool_enabled=
dalvik.vm.usap_pool_size_max=
dalvik.vm.heapstartsize=
dalvik.vm.heapmaxfree=
dalvik.vm.dex2oat-Xmx=

# PerfXT config
sys.perfmtk.current_profile=
sys.perfmtk.thermal_state=

# HyperOS / MIUI Memory Killer Disabler
persist.sys.mms.use_integrated_memory_reclaim=false
persist.sys.imr.memfree.limit=0
persist.sys.mmms.switch=false
